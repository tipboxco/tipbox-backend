events {
    worker_connections 1024;
}

http {
    # Upstream backend tanımı
    upstream backend {
        server backend:3000;
    }

    # HTTP'den HTTPS'e yönlendirme (SSL varsa)
    server {
        listen 80;
        server_name 188.245.150.117;

        # SSL yoksa direkt backend'e yönlendir
        location / {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
            
            # Timeout ayarları (büyük response'lar için artırıldı)
            proxy_connect_timeout 120s;
            proxy_send_timeout 120s;
            proxy_read_timeout 120s;
            
            # Proxy buffer ayarları (büyük JSON response'lar için)
            proxy_buffering on;
            proxy_buffer_size 16k;
            proxy_buffers 32 16k;
            proxy_busy_buffers_size 64k;
            proxy_temp_file_write_size 64k;
            proxy_max_temp_file_size 512m;
        }
        
        # Gzip compression (büyük JSON response'lar için optimize edildi)
        gzip on;
        gzip_vary on;
        gzip_proxied any;
        gzip_comp_level 6;
        gzip_min_length 1000;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
        gzip_disable "msie6";
        
        # Request body size limiti
        client_max_body_size 10M;

        # Health check endpoint
        location /health {
            proxy_pass http://backend/health;
            access_log off;
        }
    }

    # HTTPS yapılandırması (SSL sertifikası varsa)
    # Uncomment edip domain adınızı ekleyin
    # server {
    #     listen 443 ssl http2;
    #     server_name your-domain.com www.your-domain.com;
    #
    #     ssl_certificate /etc/nginx/ssl/cert.pem;
    #     ssl_certificate_key /etc/nginx/ssl/key.pem;
    #
    #     # SSL yapılandırması
    #     ssl_protocols TLSv1.2 TLSv1.3;
    #     ssl_ciphers HIGH:!aNULL:!MD5;
    #     ssl_prefer_server_ciphers on;
    #
    #     # Gzip compression (büyük JSON response'lar için optimize edildi)
    #     gzip on;
    #     gzip_vary on;
    #     gzip_proxied any;
    #     gzip_comp_level 6;
    #     gzip_min_length 1000;
    #     gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    #     gzip_disable "msie6";
    #
    #     # Request body size limiti
    #     client_max_body_size 10M;
    #
    #     location / {
    #         proxy_pass http://backend;
    #         proxy_http_version 1.1;
    #         proxy_set_header Upgrade $http_upgrade;
    #         proxy_set_header Connection 'upgrade';
    #         proxy_set_header Host $host;
    #         proxy_set_header X-Real-IP $remote_addr;
    #         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #         proxy_set_header X-Forwarded-Proto $scheme;
    #         proxy_cache_bypass $http_upgrade;
    #         
    #         # Timeout ayarları (büyük response'lar için artırıldı)
    #         proxy_connect_timeout 120s;
    #         proxy_send_timeout 120s;
    #         proxy_read_timeout 120s;
    #         
    #         # Proxy buffer ayarları (büyük JSON response'lar için)
    #         proxy_buffering on;
    #         proxy_buffer_size 16k;
    #         proxy_buffers 32 16k;
    #         proxy_busy_buffers_size 64k;
    #         proxy_temp_file_write_size 64k;
    #         proxy_max_temp_file_size 512m;
    #     }
    #
    #     # Health check endpoint
    #     location /health {
    #         proxy_pass http://backend/health;
    #         access_log off;
    #     }
    # }
}

