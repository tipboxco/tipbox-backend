# syntax=docker/dockerfile:1
# Build stage - BuildKit optimized
FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# 1) Sadece dependency dosyalarini kopyala (layer cache icin)
COPY package.json pnpm-lock.yaml ./

# 2) Dependencies'leri yukle (BuildKit cache mount)
RUN --mount=type=cache,id=pnpm-store-admin,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile || pnpm install

# 3) Source code'u kopyala
COPY . .

# 4) Build-time API URL
ARG VITE_API_BASE_URL=http://localhost:3000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm run build

# ---- Serve stage (sadece static dosya sunar) ----
FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/dist ./dist

EXPOSE 5174

CMD ["serve", "-s", "dist", "-l", "5174"]
