#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Sadece test veya staging branch'inde versiyon güncelle
CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" = "test" ] || [ "$CURRENT_BRANCH" = "staging" ]; then
  # Commit mesajını kontrol et (eğer varsa)
  COMMIT_MSG_FILE=$(git rev-parse --git-dir)/COMMIT_EDITMSG
  if [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null || echo "")
    if echo "$COMMIT_MSG" | grep -qiE "bump version|\[skip version\]"; then
      echo "ℹ️  Versiyon güncelleme atlandı (commit mesajında skip var)"
      exit 0
    fi
  fi
  
  # Mevcut versiyonu kaydet
  OLD_VERSION=$(node -p "require('./package.json').version" 2>/dev/null || echo "")
  
  # Versiyonu güncelle
  npx ts-node scripts/bump-version.ts > /tmp/bump-version.log 2>&1
  BUMP_EXIT_CODE=$?
  
  if [ $BUMP_EXIT_CODE -ne 0 ]; then
    echo "⚠️  Versiyon güncelleme hatası (devam ediliyor)"
    cat /tmp/bump-version.log >&2
    exit 0  # Pre-commit hook'u durdurmuyoruz, sadece uyarı veriyoruz
  fi
  
  # Yeni versiyonu al
  NEW_VERSION=$(node -p "require('./package.json').version" 2>/dev/null || echo "")
  
  # Eğer versiyon değiştiyse, package.json'ı stage'e ekle
  if [ "$OLD_VERSION" != "$NEW_VERSION" ]; then
    git add package.json
    echo "✅ Versiyon otomatik güncellendi: $OLD_VERSION -> $NEW_VERSION (commit'e dahil edildi)"
  fi
fi

