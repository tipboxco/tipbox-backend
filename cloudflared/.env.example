# ============================================
# Cloudflare Tunnel - Ortam Değişkenleri (Tipbox)
# ============================================
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Backend .env ile karışmaz (cloudflared/.env ayrıdır)
#
# tunnel:setup (Published routes) için gerekli

# Cloudflare API Token - Aşağıdaki izinlerle oluşturun:
#   Account → Cloudflare Tunnel → Edit
#   Zone → DNS → Edit (route dns için)
TUNNEL_CLOUDFLARE_API_TOKEN=your-tunnel-api-token

# Hesap ID (credentials'taki AccountTag veya Cloudflare Dashboard'dan)
TUNNEL_CLOUDFLARE_ACCOUNT_ID=your-account-id

# Tunnel ID (cloudflared tunnel create tipbox-tunnel ile oluşturulur)
# config.yml ile aynı değer olmalı
TUNNEL_ID=your-tunnel-uuid

# Domain (api-tipbox.TUNNEL_DOMAIN hostname için)
# Varsayılan: tipbox.co
TUNNEL_DOMAIN=tipbox.co

# API subdomain (varsayılan: api-tipbox)
# Sonuç: api-tipbox.tipbox.co
TUNNEL_API_SUBDOMAIN=api-tipbox

# Backend port (varsayılan: 3000)
# TUNNEL_BACKEND_PORT=3000

# MinIO subdomain (varsayılan: minio-tipbox)
# Sonuç: minio-tipbox.tipbox.co
# TUNNEL_MINIO_SUBDOMAIN=minio-tipbox

# MinIO port (varsayılan: 9000)
# TUNNEL_MINIO_PORT=9000
