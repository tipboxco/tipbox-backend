# =============================================================================
# Tipbox - Global .env (Docker Compose + Tüm Servisler)
# =============================================================================
# Kurulum:  cp .env.example .env
# docker-compose*.yml bu .env dosyasını kullanır (tüm servisler aynı dosyadan okur)
# Eski backend/.env kullananlar: değerleri buraya taşıyıp .env oluşturun
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose - Postgres container + DATABASE_URL içinde kullanılır
# Kullanım: docker-compose.yml (postgres env), backend/prisma-studio/catalog-service (connection string)
# Nereden alınır: Kendi belirleyin (local/dev için postgres/postgres/tipbox_dev yeterli)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tipbox_dev


X_SYNC_SECRET=test

# Docker Compose - MinIO container giriş bilgisi + backend/catalog S3 erişimi
# Kullanım: docker-compose.yml (minio env), backend S3Service, catalog-service Medusa storage
# Nereden alınır: Local MinIO için serbest seçin. Production S3: AWS IAM → https://console.aws.amazon.com/iam/
# MinIO doc: https://min.io/docs/minio/linux/reference/minio-server/setup.html
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Backend - Migration atlanır mı (entrypoint/docker-entrypoint.sh)
# Kullanım: backend container başlarken prisma migrate deploy çalıştırılması
# Nereden alınır: Dahili (0 veya 1)
SKIP_DB_MIGRATIONS=0

# Backend - Thirdweb izlenen contract adresi (webhook event filtreleme)
# Kullanım: interfaces/thirdweb-webhook, contract-event.service
# Nereden alınır: Deploy ettiğiniz ERC20/ERC721 contract adresi (Thirdweb Dashboard veya deploy çıktısı)
THIRDWEB_WATCHED_CONTRACTS=0xa6352D525BeBFd87F3De30DB7D42D08f6Ca015C6

# -----------------------------------------------------------------------------
# Backend - Prisma bağlantısı (docker-compose'ta postgres:5432 ile override edilir)
# Kullanım: backend (Prisma Client), prisma-studio
# Nereden alınır: Docker için postgres:5432; local için localhost:5432. Production: DB sağlayıcı connection string (Supabase, RDS, vb.)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tipbox_dev

# Backend + Catalog - Redis bağlantısı (cache, BullMQ kuyrukları)
# Kullanım: backend (CacheService, job queue), catalog-service (Medusa job queue)
# Nereden alınır: Docker için redis:6379. Production: Redis Cloud, Upstash vb. → https://redis.com/try-free/
REDIS_URL=redis://redis:6379

# Backend - Express sunucu portu
# Kullanım: backend server.ts / interfaces/server
# Nereden alınır: Dahili (genelde 3000)
PORT=3000
NODE_ENV=development

# Backend - Uygulamanın dışarıya açılan URL'i (webhook callback, e-posta linkleri)
# Kullanım: backend (thirdweb webhook URL, auth callback URL)
# Nereden alınır: Kendi domain (örn. https://api.tipbox.co). Local: http://localhost:3000
BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Backend + Catalog - S3/MinIO (dosya yükleme, medya)
# Kullanım: backend S3Service (infrastructure/s3), catalog-service Medusa file storage
# Nereden alınır: Local: MinIO varsayılan. Production: AWS S3 → https://console.aws.amazon.com/iam/ (Access Key), bucket/region kendi oluşturduğunuz
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=tipbox-media
S3_REGION=eu-central-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# -----------------------------------------------------------------------------
# Backend - Express CORS middleware (hangi origin'ler API'ye erişebilir)
# Kullanım: backend app.ts / CORS ayarları
# Nereden alınır: Frontend/admin panel URL'lerinizi virgülle ekleyin (localhost, production domain)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5175,https://api-test.tipbox.co,https://api-tipbox.tipbox.co
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# -----------------------------------------------------------------------------
# Backend - Auth0 (OpenID Connect login)
# Kullanım: backend auth middleware, express-openid-connect, login callback
# Nereden alınır: Auth0 Dashboard → Applications → [Uygulamanız] → Settings
#   AUTH0_DOMAIN / ISSUER_BASE_URL: https://YOUR_TENANT.region.auth0.com
#   CLIENT_ID, CLIENT_SECRET: Application Settings → Basic Info
#   AUTH0_AUDIENCE: APIs → [API] → Identifier (opsiyonel, API kullanıyorsanız)
#   SECRET: Session secret (kendiniz üretin, örn. openssl rand -hex 32)
# https://manage.auth0.com/
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
ISSUER_BASE_URL=
CLIENT_ID=
CLIENT_SECRET=
SECRET=

# Backend - JWT imzalama/doğrulama (API token'lar, internal JWT)
# Kullanım: backend auth utilities, JWT verify/sign
# Nereden alınır: Kendi ürettiğiniz gizli anahtar (örn. openssl rand -base64 32)
JWT_SECRET=

# Backend - Canny feedback widget SSO (Admin > Settings > Security > SSO redirect)
# Kullanım: backend Canny SSO entegrasyonu
# Nereden alınır: Canny → Admin → Settings → Security → SSO redirect → Private Key
# https://canny.io/admin/settings/security  (SSO redirect başlığı)
# https://developers.canny.io/install/widget/sso
CANNY_SSO_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Backend - Wallet Provider (multi-provider: thirdweb | alchemy)
# Kullanım: application/wallet/provider (wallet-provider.factory.ts)
# Nereden alınır: Dahili seçim; varsayılan "thirdweb"
#   "thirdweb" → THIRDWEB_CLIENT_ID + THIRDWEB_SECRET_KEY gerekli
#   "alchemy"  → ALCHEMY_API_KEY + ALCHEMY_ACCESS_KEY gerekli (henüz implement edilmedi)
# -----------------------------------------------------------------------------
WALLET_PROVIDER=thirdweb

# -----------------------------------------------------------------------------
# Backend - Thirdweb (Web3 wallet, NFT mint, webhook)
# Kullanım: application/wallet (wallet.service, web3-nft-service), thirdweb-webhook.router
# Nereden alınır:
#   THIRDWEB_CLIENT_ID, THIRDWEB_SECRET_KEY: https://thirdweb.com/dashboard/settings/api-keys
#   ADMIN_PRIVATE_KEY: Wallet private key (NFT mint için; cüzdan export veya deploy kullandığınız key)
#   THIRDWEB_WEBHOOK_SECRET, THIRDWEB_EVENTS_WEBHOOK_SECRET: Thirdweb Engine → Webhooks → Signing secret
#   https://engine.thirdweb.com/  (Engine dashboard)
#   Contract address: Deploy ettiğiniz contract (Thirdweb Dashboard → Contracts)
# -----------------------------------------------------------------------------
THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=
ADMIN_PRIVATE_KEY=
THIRDWEB_WEBHOOK_SECRET=
THIRDWEB_EVENTS_WEBHOOK_SECRET=
THIRDWEB_WALLET_ID=tipbox-embedded-wallet
THIRDWEB_DEFAULT_CHAIN_ID=11155111
THIRDWEB_SPONSOR_GAS=true
THIRDWEB_WEBHOOK_EXPIRATION_SECONDS=300
THIRDWEB_WEBHOOK_SKIP_SIGNATURE_IN_DEV=true
THIRDWEB_ACCOUNT_FACTORY_ADDRESS=
THIRDWEB_ECOSYSTEM_ID=
THIRDWEB_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TIPS_TOKEN_DECIMALS=18

# Backend - Alchemy (Account Kit — WALLET_PROVIDER=alchemy için)
# Kullanım: application/wallet/provider/alchemy (AlchemyProvider)
# Nereden alınır:
#   ALCHEMY_API_KEY: https://dashboard.alchemy.com/ → Apps → API Key
#   ALCHEMY_ACCESS_KEY: generateAccessKey() ile üretilir, güvenli saklayın (kurtarılamaz)
#   ALCHEMY_CHAIN_ID: Hedef chain ID (varsayılan: 11155111 Sepolia)
#   ALCHEMY_SPONSOR_GAS: Gas Manager ile gas sponsorluk ("true" / "false")
# NOT: AlchemyProvider henüz implement edilmedi. Geliştirme için migration raporuna bakın:
#      docs/thirdweb-to-alchemy-migration-report.md
# https://dashboard.alchemy.com/
# -----------------------------------------------------------------------------
ALCHEMY_API_KEY=
ALCHEMY_ACCESS_KEY=
ALCHEMY_CHAIN_ID=11155111
ALCHEMY_SPONSOR_GAS=true

# Backend - Alchemy Notify webhook imza doğrulama
# Kullanım: interfaces/alchemy-webhook (alchemy-webhook.router)
# Nereden alınır: Alchemy Dashboard → Notify → Webhooks → [Webhook] → AUTH TOKEN / signing key
# https://dashboard.alchemy.com/  (Notify → Webhooks)
# Test için: whsec_test (dokümantasyonda geçer)
ALCHEMY_WEBHOOK_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Backend - Google OAuth / Gmail / Gemini AI / Translate
# Kullanım: backend (Gmail API, Gemini service, translate), GOOGLE_APPLICATION_CREDENTIALS = service account JSON yolu
# Nereden alınır:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
#   https://console.cloud.google.com/apis/credentials
#   GEMINI_API_KEY: Google AI Studio → Get API key  https://aistudio.google.com/app/apikey
#   GOOGLE_TRANSLATE_API_KEY: Google Cloud Console → APIs & Services → Enable Cloud Translation API → Credentials
#   GOOGLE_APPLICATION_CREDENTIALS: Service account JSON key path (Gmail/Drive için; IAM → Service Accounts → Keys)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_USER_TO_IMPERSONATE=
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=30000
GOOGLE_APPLICATION_CREDENTIALS=./tipboxbackend-3e2c3d3c0b31.json

# -----------------------------------------------------------------------------
# Backend - Seed script'leri, e-posta gönderimi, MinIO CORS, wallet sync
# Kullanım: seed script'leri (SEED_*), nodemailer (EMAIL_FROM_NAME),
#          scripts/set-minio-cors.ts (MINIO_CORS_ALLOW_ORIGIN), wallet balance sync
# Nereden alınır: Dahili / kendi belirleyin. SEED_MEDIA_BASE_URL: NFT badge görseli + seed medya base URL
# -----------------------------------------------------------------------------
SEED_MEDIA_BASE_URL=http://localhost:9000
SEED_API_TOKEN=deneme
EMAIL_FROM_NAME=Tipbox
MINIO_CORS_ALLOW_ORIGIN=
WALLET_BALANCE_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# Welcome Deposit - Yeni kullanıcı ilk wallet oluşturduğunda otomatik transfer
# Kullanım: WELCOME_DEPOSIT_SOURCE_USER_EMAIL kullanıcısının wallet'ından
#           yeni kullanıcıya WELCOME_DEPOSIT_AMOUNT kadar TIPS token gönderilir.
# Nereden alınır: Kaynak kullanıcı e-postası (önceden kayıtlı ve wallet'ı dolu olmalı)
# -----------------------------------------------------------------------------
WELCOME_DEPOSIT_SOURCE_USER_EMAIL=iguzel657@gmail.com
WELCOME_DEPOSIT_AMOUNT=100

# -----------------------------------------------------------------------------
# Daily Login Reward - Her 12 saatte bir giriş yapan kullanıcıya otomatik transfer
# Kullanım: DAILY_REWARD_SOURCE_USER_EMAIL kullanıcısının wallet'ından
#           giriş yapan kullanıcıya DAILY_REWARD_AMOUNT kadar TIPS token gönderilir.
# Redis TTL ile cooldown yönetimi — aynı kullanıcı DAILY_REWARD_INTERVAL_HOURS içinde
# tekrar giriş yapsa ikinci ödül verilmez.
# Nereden alınır: Kaynak kullanıcı e-postası (önceden kayıtlı ve wallet'ı dolu olmalı)
# -----------------------------------------------------------------------------
DAILY_REWARD_SOURCE_USER_EMAIL=iguzel657@gmail.com
DAILY_REWARD_AMOUNT=100
DAILY_REWARD_INTERVAL_HOURS=12

# -----------------------------------------------------------------------------
# Provision Wallets Cron - Walletsız kullanıcılara otomatik wallet + welcome deposit
# Kullanım: Her gün belirli saatte walletsız kullanıcıları bulur, Thirdweb wallet oluşturur
#           ve welcome deposit gönderir.
# Varsayılan: Her gün 04:00 (0 4 * * *)
# Nereden alınır: Cron ifadesi (Unix crontab formatı)
# -----------------------------------------------------------------------------
PROVISION_WALLETS_CRON=0 4 * * *

# Backend - Cloudflare tunnel / public URL (webhook callback base)
# Kullanım: webhook URL oluşturma, public base URL
# Nereden alınır: Cloudflare Tunnel veya domain (örn. https://api.tipbox.co)
TUNNEL_URL=

# -----------------------------------------------------------------------------
# Catalog Service (Medusa) - Tipbox backend ile konuşma + CORS
# Kullanım: catalog-service → Tipbox API istekleri (TIPBOX_BACKEND_*), Medusa store/admin/auth CORS
# Nereden alınır: TIPBOX_BACKEND_API_KEY backend'de tanımladığınız bir token. CORS: frontend/store URL'leri
# -----------------------------------------------------------------------------
TIPBOX_BACKEND_API_KEY=deneme
TIPBOX_BACKEND_URL=http://backend:3000
MEDUSA_BACKEND_URL=http://localhost:5175
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:5175
AUTH_CORS=http://localhost:5175,http://localhost:8000

# -----------------------------------------------------------------------------
# Admin Panel - Vite build/runtime: API isteklerinin gideceği base URL
# Kullanım: admin-panel (VITE_* build-time env), api client base URL
# Nereden alınır: Backend API URL'iniz (örn. http://localhost:3000 veya https://api.tipbox.co)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
