# Catalog Service - pnpm ayarları
auto-install-peers=true
strict-peer-dependencies=false
store-dir=/root/.local/share/pnpm/store/v3

# Medusa admin dashboard için gerekli hoist pattern'leri
# @medusajs/* transitive dep'leri Vite tarafından resolve edilebilsin
# Ref: https://docs.medusajs.com/learn/configurations/pnpm
public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom
